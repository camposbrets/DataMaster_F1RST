# =============================================================
# TEMPLATE de variáveis de ambiente — copie para .env e preencha
# .env NÃO é commitado (ver .gitignore). Este arquivo SIM.
# =============================================================

# --- GCP ---
GCP_PROJECT_ID=seu-projeto-gcp
GCS_BUCKET=nome-do-seu-bucket

# --- Terraform (backend remoto GCS) ---
# Bucket DEDICADO ao state do Terraform (diferente do GCS_BUCKET de dados).
# Crie-o uma vez (ver README, Passo 4) e informe o nome aqui.
TF_STATE_BUCKET=terraform-state-seu-projeto
# Prefixo do state dentro do bucket (opcional — padrão: terraform/state)
# TF_STATE_PREFIX=terraform/state

# Caminho do service account JSON DENTRO do container Airflow.
# O arquivo físico deve estar em include/gcp/service_account.json na sua máquina.
GCP_KEYFILE_PATH=/usr/local/airflow/include/gcp/service_account.json

# --- dbt ---
DBT_TARGET=dev
DBT_DATASET=capag

# --- Airflow ---
# ID da Connection GCP configurada na UI do Airflow (Admin > Connections)
AIRFLOW_GCP_CONN_ID=gcp

# Connection GCP pré-configurada por variável de ambiente (elimina Passo 6 — Airflow UI).
# O Airflow lê AIRFLOW_CONN_<ID> e registra a conexão automaticamente ao iniciar.
# Substitua apenas se o caminho do keyfile for diferente do padrão.
AIRFLOW_CONN_GCP={"conn_type": "google_cloud_platform", "extra": {"key_path": "/usr/local/airflow/include/gcp/service_account.json"}}

# Webhook do Slack para alertas de falha (opcional)
# AIRFLOW_SLACK_WEBHOOK_URL=https://hooks.slack.com/services/XXX/YYY/ZZZ

# --- Metabase ---
# Chave da API Google Maps (opcional — para mapas no Metabase)
# MB_GOOGLE_MAPS_API_KEY=sua-chave-aqui
